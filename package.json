{
  "name": "clip-board-x",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/renderer/assets/css/styles.css -o ./src/renderer/assets/css/output.css --minify",
    "build": "npm run build:css && tsc && cpx \"src/renderer/**/*\" dist/renderer && cpx \"src/main/icon.png\" dist/main",
    "dev": "npm run build && electron . --no-sandbox --disable-setuid-sandbox",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --windows",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.berenger.clipboard",
    "productName": "ClipboardX",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "dist/main/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [],
  "author": {
    "name": "Bérenger Hto",
    "email": "llsberenger@gmail.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^25.2.2",
    "cpx": "^1.5.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@seald-io/nedb": "^4.1.2",
    "@types/socket.io": "^3.0.1",
    "dotenv": "^17.2.4",
    "hono": "^4.11.9",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  }
}